FROM kalilinux/kali-rolling

RUN apt-get update && apt-get install -y --no-install-recommends \
    nmap \
    sqlmap \
    gdb \
    python3 \
    python3-pip \
    binwalk \
    foremost \
    exiftool \
    steghide \
    stegseek \
    radare2 \
    binutils \
    file \
    xxd \
    curl \
    wget \
    netcat-openbsd \
    tcpdump \
    tshark \
    john \
    hashcat \
    gobuster \
    ffuf \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --break-system-packages \
    pwntools \
    pycryptodome \
    gmpy2 \
    z3-solver \
    requests \
    scapy \
    owiener \
    factordb-pycli

RUN mkdir -p /challenges /workspace
WORKDIR /workspace
CMD ["/bin/bash"]
