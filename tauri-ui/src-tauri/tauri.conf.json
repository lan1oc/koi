{
  "productName": "koi",
  "identifier": "com.lan1oc.koi",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "koi",
        "width": 1280,
        "height": 820,
        "minWidth": 1120,
        "minHeight": 720,
        "center": true,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "shadow": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "useLocalToolsDir": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "../../Report_Template/": "seed/Report_Template/",
      "../../modules/data_processing/templates/": "seed/templates/",
      "../../enterprise_classification.db": "seed/enterprise_classification.db",
      "../../probe-runtime/": "probe-runtime/",
      "../../probe-runtime.lock.json": "probe-runtime.lock.json",
      "../../probe-wheels.lock.json": "probe-wheels.lock.json",
      "../../pdfium-runtime/": "pdfium-runtime/",
      "../../pdfium-runtime.lock.json": "pdfium-runtime.lock.json",
      "../../archive-runtime/": "archive-runtime/",
      "../../archive-runtime.lock.json": "archive-runtime.lock.json",
      "src/backend/external_tools.lock.json": "external_tools.lock.json"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
