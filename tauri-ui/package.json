{
  "version": "4.0.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "verify:backend-contract": "node scripts/verify-backend-contract.mjs",
    "test:runtime-locks": "node --test scripts/locked-runtime.test.mjs",
    "test:release-gates": "node --test scripts/release-gates.test.mjs scripts/locked-runtime.test.mjs",
    "test:e2e": "node e2e/retest-workflows.mjs",
    "rust:preflight": "node scripts/build-backend.mjs",
    "package:flat": "node scripts/package-flat-release.mjs",
    "package:portable": "npm run package:flat",
    "package:nsis": "node scripts/package-nsis-release.mjs",
    "finalize:release": "node scripts/finalize-release.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "release:portable": "npm run rust:preflight && npm run test:release-gates && npm run tauri build -- --no-bundle && npm run package:portable",
    "release:nsis": "npm run rust:preflight && npm run test:release-gates && npm run tauri build -- --bundles nsis && npm run package:nsis",
    "release:flat": "npm run release:portable",
    "release": "npm run release:portable && npm run release:nsis"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "html2canvas": "^1.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "playwright": "1.55.0"
  }
}
